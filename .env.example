PROJECT_ID=
PROJECT_SECRET=
PHOTON_AGENT_HANDLE=
PERCEPTRON_API_KEY=
PERCEPTRON_MODEL=perceptron-mk1.5
GEMINI_API_KEY=
# The plan call tries GEMINI_TEXT_MODEL first, then each of these in turn, inside one 15s budget.
# gemini-3.8-flash answers 503 "high demand" roughly one call in three, hence the fallbacks.
GEMINI_TEXT_MODEL=
GEMINI_TEXT_FALLBACK_MODELS=
# The "after" preview illustration. Needs a billing-enabled key: every image model returns
# limit: 0 on the free tier. PREVIEW=off turns the feature off entirely.
GEMINI_IMAGE_MODEL=
PREVIEW=
